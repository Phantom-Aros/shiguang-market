# API
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://shiguang:shiguang@localhost:5432/shiguang

# Redis
REDIS_URL=redis://localhost:6379

# MinIO（阶段 2 上传使用）
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=shiguang
MINIO_USE_SSL=false

# JWT（阶段 1 鉴权使用）
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# 开发环境短信验证码（固定值，不实际发短信）
SMS_DEV_CODE=123456

# 微信小程序（可选，留空则使用 mock 登录）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 生产环境 CORS 白名单（逗号分隔，如 https://h5.example.com）
CORS_ORIGINS=

# Sentry（可选，配置后启用前端错误监控）
VITE_SENTRY_DSN=

# AI 大模型（阶段 7，OpenAI 兼容 API）
# 供应商标识，仅用于日志
AI_PROVIDER=qwen
# API 密钥（也可用 QWEN_API_KEY 兼容旧配置）
AI_API_KEY=
# API Base URL
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名称
AI_MODEL=qwen-turbo
# 无密钥时自动 mock；设为 true 强制 mock（开发省钱）
# Mock 模式不走 function calling / aiSkills 工具调用
AI_MOCK=false
# 可选：max_tokens / temperature / 限流 / mock 流式延迟（毫秒）
# AI_MAX_TOKENS=1024
# AI_TEMPERATURE=0.7
# AI_RATE_LIMIT_WINDOW_SEC=60
# AI_RATE_LIMIT_MAX=20
# AI_MOCK_CHUNK_DELAY_MS=80
